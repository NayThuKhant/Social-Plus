# Database
POSTGRES_USER=letstweet
POSTGRES_PASSWORD=letstweet
POSTGRES_DB=letstweet
DATABASE_URL=postgresql://letstweet:letstweet@localhost:5432/letstweet

# Redis
REDIS_PASSWORD=letstweet
REDIS_URL=redis://:letstweet@localhost:6379

# MinIO
MINIO_ROOT_USER=letstweet
MINIO_ROOT_PASSWORD=letstweet
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=letstweet
MINIO_SECRET_KEY=letstweet
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000
NEXT_PUBLIC_MINIO_PUBLIC_URL=http://localhost:9000

# Auth
JWT_SECRET=letstweet

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# LiveKit
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
# Set to your machine's LAN IP when testing from another device.
# Mac: ipconfig getifaddr en0   Linux: hostname -I
LIVEKIT_NODE_IP=

# pgAdmin (optional)
PGADMIN_EMAIL=admin@letstweet
PGADMIN_PASSWORD=letstweet

# Optional: Giphy GIF search (free key at https://developers.giphy.com)
GIPHY_API_KEY=
